  "mechanicsCalculations": {
    "axial": {
      "id": "axial",
      "label": "Esfuerzo y Deformación Axial",
      "description": "Cálculo de esfuerzo normal (σ) y deformación unitaria (ε) bajo carga axial.",
      "variables": [
        { "id": "P", "label": "Carga Axial (P)", "unit": "N", "default": 1000 },
        { "id": "A", "label": "Área Transversal (A)", "unit": "mm²", "default": 100 },
        { "id": "L", "label": "Longitud Inicial (L)", "unit": "mm", "default": 500 }
      ],
      "formulas": {
        "stress": "σ = P / A",
        "strain": "ε = σ / E",
        "deformation": "δ = (P × L) / (A × E)"
      }
    },
    "torsion": {
      "id": "torsion",
      "label": "Torsión en Ejes Circulares",
      "description": "Cálculo de esfuerzo cortante máximo (τ) y ángulo de giro (φ).",
      "variables": [
        { "id": "T", "label": "Par Torsor (T)", "unit": "N·m", "default": 50 },
        { "id": "c", "label": "Radio Exterior (c)", "unit": "mm", "default": 10 },
        { "id": "L", "label": "Longitud (L)", "unit": "mm", "default": 300 }
      ],
      "formulas": {
        "inertia": "J = (π × c⁴) / 2",
        "stress": "τ_max = (T × c) / J",
        "angle": "φ = (T × L) / (J × G)"
      }
    },
    "bending": {
      "id": "bending",
      "label": "Flexión en Vigas",
      "description": "Esfuerzo normal máximo por flexión (σ_max).",
      "variables": [
        { "id": "M", "label": "Momento Flector (M)", "unit": "N·m", "default": 200 },
        { "id": "c", "label": "Distancia al eje neutro (c)", "unit": "mm", "default": 25 },
        { "id": "I", "label": "Momento de Inercia (I)", "unit": "mm⁴", "default": 50000 }
      ],
      "formulas": {
        "stress": "σ_max = (M × c) / I"
      }
    }
  },

